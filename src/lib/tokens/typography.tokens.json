{
  "$description": "Type scale: 12/14/16/18/20/24/32 px plus a fluid display size. Nothing a teacher reads while standing is below 14px; nothing projected below 16px.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Roboto",
          "system-ui",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "One mono stack for code, serial output, room codes (Campus has 10 today)"
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "3xl": {
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      },
      "display": {
        "$value": "clamp(2.5rem, 5vw, 3.8rem)",
        "$description": "Entry surfaces only (join, create, landing)"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "none": {
        "$value": 1
      },
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.4
      },
      "relaxed": {
        "$value": 1.5
      }
    },
    "tracking": {
      "$type": "dimension",
      "normal": {
        "$value": {
          "value": 0,
          "unit": "em"
        }
      },
      "caps": {
        "$value": {
          "value": 0.04,
          "unit": "em"
        },
        "$description": "Uppercase labels and buttons"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.display}",
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      },
      "$description": "Entry surfaces only, once per page"
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      },
      "$description": "Draft: Roboto Condensed 26 uppercase. Condensed is tested in Storybook first"
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0.04,
          "unit": "em"
        }
      },
      "$description": "Uppercase section label"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "prose": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      },
      "$description": "Running text longer than a few lines"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      },
      "$description": "Form labels, menu items, segmented control"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      },
      "$description": "Badges, timestamps, hints. Not for anything read from a distance"
    },
    "action": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0.04,
          "unit": "em"
        }
      },
      "$description": "Button label at size m (s uses xs, l uses md). Uppercase"
    },
    "readout": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": 700,
        "lineHeight": 1,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      },
      "$description": "Machine-reported live values (IoT). Use with font-variant-numeric: tabular-nums"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.sm}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    }
  }
}
