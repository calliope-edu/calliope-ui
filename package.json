{
	"name": "@calliope-edu/ui",
	"version": "0.0.1",
	"description": "Shared Svelte 5 component library for the Calliope editors and apps",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "svelte-kit sync && storybook dev -p 6006",
		"storybook": "svelte-kit sync && storybook dev -p 6006",
		"build-storybook": "svelte-kit sync && storybook build",
		"deploy": "pnpm build-storybook && wrangler pages deploy",
		"tokens": "node scripts/build-tokens.js",
		"tokens:check": "node scripts/build-tokens.js && git diff --exit-code -- src/lib/tokens",
		"icons": "node scripts/build-icons.js",
		"test": "svelte-kit sync && vitest run",
		"package": "pnpm tokens && svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"files": [
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.stories.*",
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.stories.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./tokens": {
			"types": "./src/lib/tokens/index.ts",
			"default": "./src/lib/tokens/index.ts"
		},
		"./tokens.css": "./src/lib/tokens/tokens.css",
		"./tokens.scss": "./src/lib/tokens/tokens.scss",
		"./styles.css": "./src/lib/styles/styles.css"
	},
	"publishConfig": {
		"svelte": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js"
			},
			"./tokens": {
				"types": "./dist/tokens/index.d.ts",
				"default": "./dist/tokens/index.js"
			},
			"./tokens.css": "./dist/tokens/tokens.css",
			"./tokens.scss": "./dist/tokens/tokens.scss",
			"./styles.css": "./dist/styles/styles.css"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource-variable/roboto-condensed": "^5.3.0",
		"@iconify-json/material-symbols": "^1.2.97",
		"@iconify-json/material-symbols-light": "^1.2.98",
		"@iconify-json/prime": "^1.2.5",
		"@iconify/utils": "^3.1.7",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-themes": "^10.6.5",
		"@storybook/sveltekit": "^10.6.5",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"happy-dom": "^21.0.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"storybook": "^10.6.5",
		"style-dictionary": "^5.7.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"bits-ui": "^2.20.2"
	}
}
